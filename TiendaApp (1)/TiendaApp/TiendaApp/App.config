<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <!--
      CONFIGURACION MANUAL: cambia SOLO el valor de Server segun tu instalacion.
        SQL Server Express .......... .\SQLEXPRESS
        SQL Server instancia default  localhost   (o simplemente  .)
        LocalDB (viene con Visual Studio) (localdb)\MSSQLLocalDB
      Para ver tu nombre de servidor: es el que aparece al conectarte en SSMS.
    -->
    <add name="TiendaDb"
         connectionString="Server=.\SQLEXPRESS;Database=tienda_db;Integrated Security=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Nombre que sale como titulo en la factura impresa -->
    <add key="NombreTienda" value="MI TIENDA" />

    <!--
      true  = el cajero solo puede entrar dentro del horario de su turno
              (Mañana 6:00-14:00, Tarde 14:00-22:00, Noche 22:00-6:00).
      false = puede entrar a cualquier hora (util para probar).
    -->
    <add key="ValidarTurnoPorHora" value="false" />

    <!--
      Carpeta donde F5 guarda el .txt de cada factura (Factura_00001.txt).
      Vacio = Documentos\TiendaApp\Facturas
    -->
    <add key="CarpetaFacturas" value="" />

    <!-- true = despues de F5 tambien abre la vista previa para imprimir en papel; false = solo genera el .txt -->
    <add key="VistaPreviaAlFacturar" value="true" />
  </appSettings>
</configuration>
